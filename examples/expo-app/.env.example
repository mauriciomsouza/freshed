# Where your freshed server runs. On a device, use your machine's LAN IP, not localhost.
EXPO_PUBLIC_FRESHED_URL=http://192.168.0.10:8787
# Public, read-only key (fr_pub_...). Safe to ship in the app: it can only read published content.
EXPO_PUBLIC_FRESHED_KEY=fr_pub_replace_me_with_your_public_key
