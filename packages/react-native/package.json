{
  "name": "@freshed/react-native",
  "version": "0.1.0",
  "description": "Render server-driven screens and flows from freshed in Expo and React Native apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/core/index.ts --format esm --dts --clean --external react --external react-native",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@freshed/schema": "workspace:*",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "tsup": "9.0.0",
    "@freshed/example-brew": "workspace:*",
    "react-native": "0.88.1"
  }
}
