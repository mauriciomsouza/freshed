{
  "name": "freshed",
  "version": "0.1.0",
  "description": "freshed CLI: generate draft screens and app components from one prompt with your own LLM key.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "freshed": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --no-splitting --noExternal @freshed/ai --noExternal @freshed/schema",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@freshed/ai": "workspace:*",
    "@freshed/schema": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@freshed/example-brew": "workspace:*",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
