# Copy to .env for docker compose. Never commit .env.
POSTGRES_PASSWORD=change-me
# Generate with: node -e "console.log('fr_admin_' + require('crypto').randomBytes(24).toString('base64url'))"
FRESHED_ADMIN_KEY=fr_admin_replace_me_with_a_random_value
# Generate with: node -e "console.log('fr_pub_' + require('crypto').randomBytes(24).toString('base64url'))"
FRESHED_PUBLIC_KEY=fr_pub_replace_me_with_a_random_value
FRESHED_SEED=brew
FRESHED_CORS=http://localhost:5173
# Optional: server-side freshed ai (key stays in server env, never in the database)
FRESHED_AI_KEY=
FRESHED_AI_PROVIDER=anthropic
FRESHED_AI_MODEL=
