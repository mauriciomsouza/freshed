    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@freshed/ai": "workspace:*",
    "@freshed/example-brew": "workspace:*",
    "@freshed/example-expo-app": "workspace:*",
    "@freshed/react-native": "workspace:*",
    "@freshed/schema": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "react-native": "0.88.1"
  }
}
