{
  "name": "@freshed/studio",
  "version": "0.1.0",
  "private": true,
  "description": "freshed Studio: the CMS UI for components, screens, flows, publishing and freshed ai.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages && cp dist-pages/index.html dist-pages/404.html",
